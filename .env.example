# Referencia de configuración para el backend.
# PowerShell no carga este archivo automáticamente; define las variables
# con $env:NOMBRE = "valor" en la terminal antes de iniciar Spring Boot.
PULSEPASS_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pulsepass
PULSEPASS_DATASOURCE_USERNAME=pulsepass
PULSEPASS_DATASOURCE_PASSWORD=pulsepass
PULSEPASS_JWT_SECRET=
PULSEPASS_JWT_EXPIRATION_MS=900000
PULSEPASS_JWT_ISSUER=pulsepass-api
